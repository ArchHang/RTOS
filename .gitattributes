# Recorded HIL digests refer to exact bytes, including original line endings.
hil/**/*.txt -text -whitespace
hil/**/*.json -text -whitespace
hil/**/*.log -text -whitespace
hil/**/*.csv -text -whitespace

# Preserve CubeIDE-generated templates and historical snapshots as recorded.
hil/templates/** -whitespace
hil/archive_tests/** -whitespace

# Preserve the refactor batch's original fixture and isolated IDE snapshots.
hil/refactor_20261027/evidence/preflight/before_guard_mapping_fix/basepri_guard.c.recorded -text -whitespace
hil/refactor_20261027/evidence/ide/*.xml -text -whitespace
hil/refactor_20261027/evidence/ide/generated/** -text -whitespace

# These offline validators are identified by exact SHA256 in the evidence.
hil/basepri_20261025/verify_evidence.py -text
hil/adversarial_20261025/verify_evidence.py -text
hil/refactor_20261027/verify_layout.py -text
# The dated validator's EOF padding is part of its recorded digest.
hil/refactor_20261027/verify_results.py -text whitespace=-blank-at-eof

# Keep published Markdown consistent across Windows and Unix checkouts.
*.md text eol=lf

# New dated evidence includes hashed scripts and mock/source snapshots as well
# as logs. Preserve their original bytes; the README is maintained prose.
hil/channel_20261027/** -text -whitespace
hil/channel_shared_20261027/** -text -whitespace
hil/diagnostics_20261027/** -text -whitespace
hil/channel_20261027/**/*.md text eol=lf
hil/channel_shared_20261027/**/*.md text eol=lf
hil/diagnostics_20261027/**/*.md text eol=lf

# This compiled fixture's EOF padding is part of the captured input digest.
hil/fw/Src/channel_fixture.c whitespace=-blank-at-eof

# These measured inputs contain mixed LF/CRLF. Preserve the actual tested
# bytes; uniform EOL reconstruction cannot recover their original SHA256.
RTOS/IPC/rtos_event.c -text whitespace=cr-at-eol
hil/fw/Src/kern_port_rtos.c -text whitespace=cr-at-eol
hil/fw/Src/test_framework.c -text whitespace=cr-at-eol
